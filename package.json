{
	"name": "campaigns-greenchat",
	"version": "1.6.1",
	"description": "API for Campaigns Greenchat Microservices.",
	"main": "index.js",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"dev:queue": "tsx watch src/consumer.ts",
		"build": "tsup",
		"start": "node build/server.js",
		"lint": "eslint --fix --ext .ts,.tsx .",
		"prettier": "prettier --write \"src/**/*.{ts,tsx}\"",
		"start:queue": "node build/consumer.js",
		"migration:generate": "drizzle-kit generate:mysql",
		"migration:run": "tsx src/migrations/run.migrations.ts",
		"migration:push": "drizzle-kit push:mysql",
		"schemas:import": "drizzle-kit introspect:mysql",
		"test": "jest --passWithNoTests --runInBand --no-cache --forceExit",
		"prepare": "husky"
	},
	"keywords": [
		"NodeJS",
		"RabbitMQ",
		"Fastify",
		"zod"
	],
	"author": "InfoReis",
	"license": "ISC",
	"homepage": "https://github.com/Pharma-Chat-Bot/campaigns-pharmachatbot#readme",
	"bugs": {
		"url": "https://github.com/Pharma-Chat-Bot/campaigns-pharmachatbot/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Pharma-Chat-Bot/campaigns-pharmachatbot.git"
	},
	"engines": {
		"node": "20.9.0"
	},
	"dependencies": {
		"@fastify/cors": "9.0.1",
		"@fastify/helmet": "11.1.1",
		"amqplib": "0.10.3",
		"axios": "1.6.7",
		"bullmq": "5.12.13",
		"chillout": "5.0.0",
		"csv-parser": "3.0.0",
		"dayjs": "1.11.10",
		"dotenv": "^16.4.1",
		"download": "8.0.0",
		"drizzle-orm": "0.29.4",
		"fastify": "4.26.0",
		"fastify-plugin": "4.5.1",
		"form-data": "4.0.0",
		"ioredis": "5.8.2",
		"mysql2": "3.14.2",
		"node-cron": "3.0.3",
		"pino": "10.0.0",
		"pino-pretty": "13.1.2",
		"pino-rotating-file-stream": "0.0.2",
		"redis": "4.7.0",
		"tsup": "^8.0.2",
		"uuid": "10.0.0",
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@semantic-release/changelog": "6.0.3",
		"@semantic-release/commit-analyzer": "13.0.1",
		"@semantic-release/git": "10.0.1",
		"@semantic-release/github": "11.0.5",
		"@semantic-release/npm": "11.0.2",
		"@semantic-release/release-notes-generator": "14.0.3",
		"@types/amqplib": "0.10.4",
		"@types/chillout": "5.0.6",
		"@types/jest": "29.5.12",
		"@types/node": "^20.11.19",
		"@typescript-eslint/eslint-plugin": "^7.0.1",
		"@typescript-eslint/parser": "^7.0.1",
		"drizzle-kit": "0.20.14",
		"eslint": "^8.56.0",
		"eslint-config-airbnb-base": "^15.0.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-import-resolver-typescript": "^3.6.1",
		"eslint-plugin-import": "^2.29.1",
		"eslint-plugin-import-helpers": "^1.3.1",
		"eslint-plugin-prettier": "^5.1.3",
		"husky": "9.1.5",
		"ioredis-mock": "8.9.0",
		"jest": "29.7.0",
		"lint-staged": "15.2.10",
		"prettier": "^3.2.5",
		"semantic-release": "24.2.7",
		"supertest": "7.0.0",
		"ts-jest": "29.2.5",
		"ts-node": "^10.9.2",
		"tsx": "^4.7.1",
		"typescript": "^5.3.3"
	}
}
